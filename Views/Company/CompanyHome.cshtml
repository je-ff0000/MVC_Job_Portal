@{
    ViewBag.Title = "CompanyHome";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">

    <div class="jumbotron">
        <h2>Welcome, @ViewBag.CompanyName</h2>
        <p>Company Dashboard</p>
    </div>
    <div class="text-center", style="margin-bottom: 20px">
        @Html.ActionLink("Post New Job", "InsertJob_PageLoad", "Company", null, new { @class = "btn btn-primary btn-lg", style = "margin-right:50px;" })

        @Html.ActionLink("View Posted Jobs", "ViewJobs_PageLoad", "Company", null, new { @class = "btn btn-success btn-lg", style = "margin-right:50px;" })
    </div>
    <div>
        <ul class="list-group">
            <li class="list-group-item">Total Posted Jobs <span class="badge">@ViewBag.TotalJobs</span></li>
            <li class="list-group-item">Active <span class="badge">@ViewBag.ActiveJobs</span></li>
            <li class="list-group-item">Closed Jobs <span class="badge">@ViewBag.ClosedJobs</span></li>
        </ul>

    </div>
    

</div>




