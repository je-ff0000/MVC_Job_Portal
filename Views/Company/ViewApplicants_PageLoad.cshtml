@model IEnumerable<MVC_Project_Job_Portal.sp_GetApplicantsByJob_Result>
@{
    ViewBag.Title = "ViewApplicants_PageLoad";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2>Applicants</h2>
<br />

@Html.ActionLink(
    "Back to Posted Jobs",
    "ViewJobs_PageLoad",
    null,
    new { @class = "btn btn-primary" })


@if (ViewBag.Message != null)
{
    <div class="alert alert-info">
        @ViewBag.Message
    </div>
}

<br />
@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-striped">

        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Qualification</th>
            <th>Skills</th>
            <th>Applied On</th>
            <th>Resume</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.EmployeeName</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.Qualification</td>
                <td>@item.Skills</td>
                <td>@item.AppliedDate</td>
                <td>
                    <a href="@Url.Content(item.ResumePath)" target="_blank">
                        View Resume
                    </a>
                </td>
                <td>
                    @if (item.ApplicationStatus == "Accepted")
                    {
                        <span class="label label-success">Accepted</span> 
                    }
                    else if (item.ApplicationStatus == "Rejected")
                    {
                        <span class="label label-danger">Rejected</span> 
                    }
                    else
                    {
                        <span class="label label-info">Applied</span>
                    }
                </td>
                <td>
                    @if(item.ApplicationStatus == "Applied")
                    {
                        @Html.ActionLink(
                       "Accept",
                       "UpdateApplicationStatus",
                       new { applicationId = item.ApplicationId,
                             jobId = ViewBag.JobId,
                             status = "Accepted"},
                       new { @class = "btn btn-success btn-md" })

                    @Html.Raw(" ")

                    @Html.ActionLink(
                        "Reject",
                        "UpdateApplicationStatus",
                        new { applicationId = item.ApplicationId,
                              jobId = ViewBag.JobId,
                              status = "Rejected"},
                        new { @class = "btn btn-danger btn-md" })
                    }
                    
                </td>
            </tr>

        }

    </table>
}
else
{
    <h4>No Applicants Found.</h4>
}